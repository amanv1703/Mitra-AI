{
  "name": "mitra-ai",
  "version": "0.1.0",
  "description": "MITRA AI — AI Business Operator for Modern Merchants",
  "private": true,
  "scripts": {
    "start": "npm start --prefix backend",
    "build": "npm install --prefix backend",
    "postinstall": "npm install --prefix backend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "test": "npm test --prefix backend",
    "test:backend": "npm test --prefix backend",
    "evaluate:ai": "node scripts/evaluateAgent.js",
    "evaluate:intelligence": "node scripts/evaluateIntelligence.js",
    "evaluate:actions": "node scripts/evaluateActions.js",
    "install:all": "npm install && npm install --prefix backend && npm install --prefix frontend",
    "generate:data": "node scripts/generateDataset.js",
    "db:schema": "node scripts/resetDatabase.js",
    "db:seed": "node scripts/seedDatabase.js",
    "db:reset": "node scripts/resetDatabase.js && node scripts/seedDatabase.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "mysql2": "^3.10.0",
    "openai": "^4.47.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
